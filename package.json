{
    "name": "PxGBA",
    "private": true,
    "version": "0.4.1",
    "type": "module",
    "author": {
        "name": "LIFTED PIXEL",
        "email": "dev@liftedpixel.ca",
        "url": "https://liftedpixel.ca"
    },
    "license": "MIT",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node -e \"const p=require('./package.json'); require('fs').writeFileSync('dist/version.txt', p.version)\" && powershell -NoProfile -Command \"Remove-Item -Path 'dist/latest.zip' -ErrorAction SilentlyContinue; Compress-Archive -Path 'dist/*' -DestinationPath 'dist/latest.zip'\"",
        "lint": "eslint .",
        "preview": "vite preview",
        "start": "node src/components/server.js",
        "electron:dev": "concurrently \"vite\" \"electron . --dev --vite\"",
        "electron:dev:server": "electron . --dev",
        "electron:build:win": "vite build && electron-builder --win --config",
        "electron:build:linux": "vite build && electron-builder --linux --config",
        "electron:build:all": "vite build && electron-builder --win --linux --config",
        "desktop:setup": "node scripts/download-build-tools.cjs",
        "postinstall": "node scripts/bundle-iodine.cjs"
    },
    "dependencies": {
        "ag-psd": "^30.1.1",
        "iodine-gba": "^2.0.1",
        "jszip": "^3.10.1",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-hot-toast": "^2.6.0",
        "react-icons": "^5.6.0",
        "reactflow": "^11.11.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "concurrently": "^9.1.2",
        "electron": "^33.4.0",
        "electron-builder": "^25.1.8",
        "eslint": "^10.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "vite": "^8.0.12"
    },
    "main": "electron/main.cjs",
    "build": {
        "appId": "ca.liftedpixel.pxgba",
        "productName": "PxGBA",
        "directories": {
            "buildResources": "build",
            "output": "release"
        },
        "asarUnpack": ["dist/**/*"],
        "files": [
            "dist/**/*", "electron/**/*", "scripts/**/*", "package.json"
        ],

        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": ["x64"]
                }
            ],
            "icon": "public/icon-512.png",
            "extraResources": [
                {
                    "from": "api",
                    "to": "api",
                    "filter": ["!node_modules/**/*", "!server.txt", "!SERVER_SETUP.md", "!buildTools/linux/**/*"]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": true
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": ["x64"]
                }
            ],
            "category": "Development",
            "icon": "public/icon-512.png",
            "extraResources": [
                {
                    "from": "api",
                    "to": "api",
                    "filter": ["!node_modules/**/*", "!server.txt", "!SERVER_SETUP.md", "!buildTools/windows/**/*"]
                }
            ]
        },
        "afterPack": "scripts/after-pack.cjs"
    }
}
